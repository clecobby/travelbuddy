{
  "expo": {
    "name": "Travel Buddy",
    "slug": "travelbuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "travelbuddy",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0d10",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "app.travelbuddy.companion",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Travel Buddy turns what you say into questions and commands.",
        "NSMicrophoneUsageDescription": "Travel Buddy listens when you talk to it."
      }
    },
    "android": {
      "package": "app.travelbuddy.companion",
      "adaptiveIcon": {
        "backgroundColor": "#0b0d10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0d10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Travel Buddy films your trip and looks through the camera when you ask what you're seeing.",
          "microphonePermission": "Travel Buddy listens when you talk to it.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Travel Buddy uses your location to tell you about where you are and to map your trips."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Travel Buddy listens when you talk to it.",
          "speechRecognitionPermission": "Travel Buddy turns what you say into questions and commands."
        }
      ],
      "expo-video",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "03e9de96-d877-4402-b0e9-369bdf66ba44"
      }
    },
    "owner": "clecobby",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/03e9de96-d877-4402-b0e9-369bdf66ba44",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "dev"
      }
    }
  }
}
