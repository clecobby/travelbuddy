# The API and the Cognito app client for the stage you're testing (printed by deploy/bootstrap-aws.sh dev).
# Without EXPO_PUBLIC_API_URL the app uses a backend on the machine running `expo start` (port 4100).
EXPO_PUBLIC_API_URL=https://...lambda-url.us-east-1.on.aws
EXPO_PUBLIC_COGNITO_CLIENT_ID=
