{
  "name": "travelbuddy-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/local.ts",
    "start": "node --env-file-if-exists=.env src/local.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/lambda.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/lambda.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1175.0",
    "@aws-sdk/client-dynamodb": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1173.0",
    "@aws-sdk/lib-dynamodb": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@codegenie/serverless-express": "^5.0.0",
    "aws-jwt-verify": "^5.2.1",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "private": true
}
